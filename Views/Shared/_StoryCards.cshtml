@model IReadOnlyList<StoryCardViewModel>

@if (Model.Count == 0)
{
    <div class="alert alert-light border mb-0">No stories match the current filter.</div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.StoryName" style="height: 280px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 280px;">
                            No cover
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @if (!string.IsNullOrWhiteSpace(item.CategoryName))
                            {
                                <span class="badge text-bg-light">@item.CategoryName</span>
                            }
                            @if (item.IsFavourite)
                            {
                                <span class="badge text-bg-warning">Favorite</span>
                            }
                        </div>

                        <h2 class="h5 mb-2">@item.StoryName</h2>
                        <p class="text-muted small mb-2">
                            @(string.IsNullOrWhiteSpace(item.AuthorName) ? "Unknown author" : item.AuthorName)
                        </p>
                        <p class="text-muted flex-grow-1 mb-3">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "No description yet." : item.Description)
                        </p>

                        <div class="small text-muted mb-3">
                            <span class="me-3">@item.ChapterCount chapters</span>
                            <span class="me-3">@item.Views views</span>
                            @if (item.Rating.HasValue)
                            {
                                <span>Rating @item.Rating.Value.ToString("0.0")</span>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Home" asp-action="Story" asp-route-id="@item.StoryId" class="btn btn-primary btn-sm">View story</a>
                            @if (item.LastReadChapterId.HasValue)
                            {
                                <a asp-controller="Home" asp-action="Chapter" asp-route-id="@item.LastReadChapterId" class="btn btn-outline-secondary btn-sm">Continue</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
