@model ChapterFormViewModel
@{
    var actionName = Model.ChapterId.HasValue ? "EditChapter" : "CreateChapter";
}

<main class="py-5">
    <div class="container">
        <div class="mb-4">
            <a asp-controller="Writer" asp-action="Chapters" asp-route-storyId="@Model.StoryId" class="text-decoration-none small">Quay lại chương</a>
            <h1 class="h2 mt-2 mb-1">@(Model.ChapterId.HasValue ? "Chỉnh sửa chương" : "Tạo chương")</h1>
            <p class="text-muted mb-0">Truyện: @Model.StoryName</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="@actionName" asp-route-id="@Model.ChapterId" method="post">
                    <input asp-for="ChapterId" type="hidden" />
                    <input asp-for="StoryId" type="hidden" />
                    <input asp-for="StoryName" type="hidden" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-lg-4">
                            <label asp-for="ChapterNumber" class="form-label"></label>
                            <input asp-for="ChapterNumber" class="form-control" />
                            <span asp-validation-for="ChapterNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-lg-8">
                            <label asp-for="ChapterName" class="form-label"></label>
                            <input asp-for="ChapterName" class="form-control" />
                            <span asp-validation-for="ChapterName" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="18"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">Lưu chương</button>
                        <a asp-controller="Writer" asp-action="Chapters" asp-route-storyId="@Model.StoryId" class="btn btn-outline-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
