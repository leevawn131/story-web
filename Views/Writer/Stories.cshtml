@model IReadOnlyList<WriterStoryListItemViewModel>

<main class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <a asp-controller="Account" asp-action="Profile" class="text-decoration-none small">Quay lại hồ sơ</a>
                <h1 class="h2 mt-2 mb-1">Truyện của tôi</h1>
                <p class="text-muted mb-0">Tạo, chỉnh sửa và sắp xếp các truyện bạn xuất bản.</p>
            </div>
            <a asp-action="CreateStory" class="btn btn-primary">Tạo truyện</a>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (TempData["InfoMessage"] is string infoMessage)
        {
            <div class="alert alert-info">@infoMessage</div>
        }

        @if (Model.Count == 0)
        {
            <div class="alert alert-light border">
                Bạn chưa tạo truyện nào.
            </div>
        }
        else
        {
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Truyện</th>
                            <th>Thể loại</th>
                            <th>Trạng thái</th>
                            <th>Chương</th>
                            <th>Cập nhật</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.StoryName</td>
                                <td>@(item.CategoryName ?? "Chưa phân loại")</td>
                                <td>@(item.PostStatus ?? "Nháp")</td>
                                <td>@item.ChapterCount</td>
                                <td>@(item.ModifiedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a asp-action="Chapters" asp-route-storyId="@item.StoryId" class="btn btn-outline-primary btn-sm">Chương</a>
                                        <a asp-action="EditStory" asp-route-id="@item.StoryId" class="btn btn-outline-secondary btn-sm">Chỉnh sửa</a>
                                        <a asp-controller="Home" asp-action="Story" asp-route-id="@item.StoryId" class="btn btn-outline-dark btn-sm">Xem</a>
                                        <form asp-action="DeleteStory" asp-route-id="@item.StoryId" method="post" class="d-inline" onsubmit="return confirm('Xóa truyện này và tất cả chương của nó?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</main>
