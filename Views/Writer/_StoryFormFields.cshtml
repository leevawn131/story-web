@model WriterStoryEditorViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Form.StoryName" class="form-label"></label>
        <input asp-for="Form.StoryName" class="form-control" />
        <span asp-validation-for="Form.StoryName" class="text-danger"></span>
    </div>

    <div class="col-12 col-lg-6">
        <label asp-for="Form.CategoryId" class="form-label"></label>
        <select asp-for="Form.CategoryId" class="form-select">
            <option value="">Select a category</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.CategoryId">@category.CategoryName</option>
            }
        </select>
        <span asp-validation-for="Form.CategoryId" class="text-danger"></span>
    </div>

    <div class="col-12 col-lg-6">
        <label asp-for="Form.ImageFile" class="form-label"></label>
        <input asp-for="Form.ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
        <small class="text-muted">JPG, PNG, GIF, WebP (max 5 MB)</small>
        <span asp-validation-for="Form.ImageFile" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Form.CurrentImage))
    {
        <div class="col-12">
            <p class="form-text">Current cover image:</p>
            <img src="@Model.Form.CurrentImage" alt="Current cover" style="max-width: 200px; max-height: 300px; object-fit: cover;" class="rounded" />
            <p class="form-text text-muted small">Upload a new image to replace</p>
        </div>
    }

    <div class="col-12">
        <label asp-for="Form.Description" class="form-label"></label>
        <small class="d-block text-muted mb-2">Summary that appears on the homepage</small>
        <textarea asp-for="Form.Description" class="form-control" rows="6" placeholder="Brief description of your story..."></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <button type="submit" class="btn btn-primary">Save story</button>
    <a asp-controller="Writer" asp-action="Stories" class="btn btn-outline-secondary">Cancel</a>
</div>
