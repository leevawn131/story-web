@model WriterStoryEditorViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Form.StoryName" class="form-label"></label>
        <input asp-for="Form.StoryName" class="form-control" />
        <span asp-validation-for="Form.StoryName" class="text-danger"></span>
    </div>

<div class="col-12 col-lg-6">

    <label class="form-label">Thể loại</label>
<label class="form-label">Thể loại</label>

<div class="row">
    @foreach (var item in Model.Categories)
    {
        <div class="col-12 col-md-6">
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="Form.SelectedCategories"
                       value="@item.CategoryId"
                       id="cat_@item.CategoryId" />
                <label class="form-check-label" for="cat_@item.CategoryId">
                    @item.CategoryName
                </label>
            </div>
        </div>
    }
</div>
</div>
<div class="col-12 col-lg-6">

    <label class="form-label">Tình trạng</label>

    <select asp-for="Form.StoryStatus"
            class="form-select">

        <option value="dang_ra">
            Đang ra
        </option>

        <option value="hoan_thanh">
            Hoàn thành
        </option>

        <option value="tam_ngung">
            Tạm ngưng
        </option>

    </select>

</div>

    <div class="col-12 col-lg-6">
        <label asp-for="Form.ImageFile" class="form-label"></label>
        <input asp-for="Form.ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
        <small class="text-muted">JPG, PNG, GIF, WebP (tối đa 5 MB)</small>
        <span asp-validation-for="Form.ImageFile" class="text-danger"></span>
    </div>

    @if (!string.IsNullOrEmpty(Model.Form.CurrentImage))
    {
        <div class="col-12">
            <p class="form-text">Ảnh bìa hiện tại:</p>
            <img src="@Model.Form.CurrentImage" alt="Current cover" style="max-width: 200px; max-height: 300px; object-fit: cover;" class="rounded" />
            <p class="form-text text-muted small">Tải lên hình ảnh mới để thay thế</p>
        </div>
    }

    <div class="col-12">
        <label asp-for="Form.Description" class="form-label"></label>
        <small class="d-block text-muted mb-2">Tóm tắt xuất hiện trên trang chủ</small>
        <textarea asp-for="Form.Description" class="form-control" rows="6" placeholder="Mô tả ngắn về truyện của bạn..."></textarea>
        <span asp-validation-for="Form.Description" class="text-danger"></span>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mt-4">
    <button type="submit" class="btn btn-primary">Lưu truyện</button>
    <a asp-controller="Writer" asp-action="Stories" class="btn btn-outline-secondary">Hủy</a>
</div>
