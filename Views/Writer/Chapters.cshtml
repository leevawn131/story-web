@model WriterStoryManageViewModel
@{
    string FormatChapterNumber(decimal? number)
    {
        if (!number.HasValue)
        {
            return "?";
        }

        return decimal.Truncate(number.Value) == number.Value
            ? decimal.ToInt32(number.Value).ToString()
            : number.Value.ToString("0.##");
    }
}

<main class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <a asp-controller="Writer" asp-action="Stories" class="text-decoration-none small">Quay lại truyện của tôi</a>
                <h1 class="h2 mt-2 mb-1">@Model.StoryName</h1>
                <p class="text-muted mb-0">Trạng thái: @(Model.PostStatus ?? "Nháp")</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="CreateChapter" asp-route-storyId="@Model.StoryId" class="btn btn-primary">Thêm chương</a>
                <a asp-action="EditStory" asp-route-id="@Model.StoryId" class="btn btn-outline-secondary">Chỉnh sửa truyện</a>
                <a asp-controller="Home" asp-action="Story" asp-route-id="@Model.StoryId" class="btn btn-outline-dark">Xem trang công khai</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        @if (Model.PostStatus == "cho_duyet")
        {
            <div class="alert alert-warning">
                <strong>⏳ Chờ xem xét:</strong> Truyện của bạn đã được gửi để xem xét của quản trị viên. Sau khi được chấp phê, nó sẽ được xuất bản và hiển thị cho độc giả.
            </div>
        }
        else if (Model.PostStatus == "da_duyet")
        {
            <div class="alert alert-success">
                <strong>✅ Xuất bản:</strong> Truyện của bạn đã được chấp phê và hiện đang hiển thị cho độc giả.
            </div>
        }
        else if (Model.PostStatus == "tu_choi")
        {
            <div class="alert alert-danger">
                <strong>❌ Bị từ chối:</strong> Truyện của bạn đã bị từ chối.
                @if (!string.IsNullOrEmpty(Model.RejectReason))
                {
                    <p class="mb-0 mt-2"><strong>Lý do:</strong> @Model.RejectReason</p>
                }
            </div>
        }

        @if (Model.Chapters.Count == 0)
        {
            <div class="alert alert-light border">Chưa có chương nào. Bắt đầu bằng cách thêm chương đầu tiên của bạn.</div>
        }
        else
        {
            <div class="table-responsive shadow-sm rounded">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Số</th>
                            <th>Tiêu đề</th>
                            <th>Cập nhật</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var chapter in Model.Chapters)
                        {
                            <tr>
                                <td>@FormatChapterNumber(chapter.ChapterNumber)</td>
                                <td class="fw-semibold">@chapter.ChapterName</td>
                                <td>@(chapter.PostedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                <td class="text-end">
                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a asp-controller="Home" asp-action="Chapter" asp-route-id="@chapter.ChapterId" class="btn btn-outline-dark btn-sm">Đọc</a>
                                        <a asp-action="EditChapter" asp-route-id="@chapter.ChapterId" class="btn btn-outline-primary btn-sm">Chỉnh sửa</a>
                                        <form asp-action="DeleteChapter" asp-route-id="@chapter.ChapterId" method="post" class="d-inline" onsubmit="return confirm('Xóa chương này?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</main>
