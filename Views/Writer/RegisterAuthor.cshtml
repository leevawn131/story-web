@model AuthorRegistrationViewModel

<main class="py-5">
    <div class="container" style="max-width: 760px;">
        <div class="mb-4">
            <a asp-controller="Account" asp-action="Profile" class="text-decoration-none small">Quay lại hồ sơ</a>
            <h1 class="h2 mt-2 mb-1">Đăng ký làm tác giả</h1>
            <p class="text-muted mb-0">Bạn cần hồ sơ tác giả có bút danh trước khi đăng truyện.</p>
        </div>

        @if (TempData["InfoMessage"] is string infoMessage)
        {
            <div class="alert alert-info">@infoMessage</div>
        }

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="RegisterAuthor" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="PenName" class="form-label"></label>
                        <input asp-for="PenName" class="form-control" placeholder="Bút danh công khai của bạn" />
                        <span asp-validation-for="PenName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Bio" class="form-label"></label>
                        <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Giới thiệu ngắn về bạn"></textarea>
                        <span asp-validation-for="Bio" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Avatar" class="form-label"></label>
                        <input asp-for="Avatar" class="form-control" placeholder="https://..." />
                        <span asp-validation-for="Avatar" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Lưu hồ sơ tác giả</button>
                        <a asp-controller="Writer" asp-action="Stories" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
