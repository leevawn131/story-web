@model story_web.Models.Membership

@{
    ViewData["Title"] = "Thanh Toán Gói VIP";
    // Lấy thông tin user đăng nhập từ Session (nếu có)
    var currentUserName = Context.Session.GetCurrentUserName();
}

<main class="py-5" style="background-color: #f8f9fa;">
    <div class="container">
        <!-- Progress Steps -->
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="d-flex justify-content-between align-items-center position-relative">
                    <div class="position-absolute top-50 start-0 end-0 translate-middle-y bg-secondary bg-opacity-25" style="height: 3px; z-index: 1;"></div>
                    <div class="position-absolute top-50 start-0 bg-primary" style="height: 3px; width: 50%; z-index: 2; transition: width 0.3s ease;"></div>
                    
                    <div class="text-center position-relative" style="z-index: 3;">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px; font-weight: bold;">1</div>
                        <span class="d-block mt-2 small fw-semibold text-primary">Chọn Gói VIP</span>
                    </div>
                    <div class="text-center position-relative" style="z-index: 3;">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px; font-weight: bold;">2</div>
                        <span class="d-block mt-2 small fw-semibold text-primary">Thanh Toán</span>
                    </div>
                    <div class="text-center position-relative" style="z-index: 3;">
                        <div class="rounded-circle bg-white text-secondary border border-secondary border-opacity-50 d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 40px; height: 40px; font-weight: bold;">3</div>
                        <span class="d-block mt-2 small text-muted">Hoàn Tất</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Payment Methods Selection -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h4 class="fw-bold mb-0 text-dark">Phương thức thanh toán</h4>
                        <p class="text-muted small mb-0">Vui lòng chọn hình thức thanh toán giả lập phía dưới</p>
                    </div>
                    <div class="card-body p-4">
                        <!-- Navigation Tabs -->
                        <ul class="nav nav-pills nav-fill bg-light p-1 rounded-3 mb-4" id="paymentTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active rounded-3 py-2 fw-semibold" id="qr-tab" data-bs-toggle="tab" data-bs-target="#qr-pane" type="button" role="tab" aria-controls="qr-pane" aria-selected="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-qr-code me-2" viewBox="0 0 16 16">
                                        <path d="M2 2h2v2H2V2Z"/>
                                        <path d="M6 0v6H0V0h6ZM5 1H1v4h4V1ZM4 12H2v2h2v-2Z"/>
                                        <path d="M6 10v6H0v-6h6ZM5 11H1v4h4v-4Zm10-9h-2v2h2V2Z"/>
                                        <path d="M16 0v6h-6V0h6Zm-1 1h-4v4h4V1Zm-6 4h1v1H9V5Zm1 0h1v1h-1V5Zm-2 2h1v1H8V7Zm1 4h1v1H9v-1Zm1 2h2v1h-2v-1Zm1 1h1v1h-1v-1Zm0-4h1v1.75h-1V11Zm-2 1h1v1H8v-1Zm-3 1h1v1H5v-1Zm-1-2h1v1H4v-1Zm2-1h1v1H6v-1Zm-1-2h1.5v1H5V7Zm-3 0h.5v.5H2V7Zm-1 2h1v1H1V9Zm2 2h1v1H3v-1Z"/>
                                    </svg> Chuyển khoản QR
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-3 py-2 fw-semibold" id="momo-tab" data-bs-toggle="tab" data-bs-target="#momo-pane" type="button" role="tab" aria-controls="momo-pane" aria-selected="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-wallet2 me-2" viewBox="0 0 16 16">
                                        <path d="M12.136.326A1.5 1.5 0 0 1 14 1.78V3h.5A1.5 1.5 0 0 1 16 4.5v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 0 13.5v-9a1.5 1.5 0 0 1 1.463-1.474l10.673-2.7ZM1.5 4a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5V5h-10a.5.5 0 0 1-.5-.5V4H1.5Z"/>
                                    </svg> Ví MoMo
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link rounded-3 py-2 fw-semibold" id="card-tab" data-bs-toggle="tab" data-bs-target="#card-pane" type="button" role="tab" aria-controls="card-pane" aria-selected="false">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-credit-card me-2" viewBox="0 0 16 16">
                                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v1h14V4a1 1 0 0 0-1-1H2zm13 4H1v5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V7z"/>
                                    </svg> Thẻ Quốc Tế
                                </button>
                            </li>
                        </ul>

                        <!-- Tab Content Areas -->
                        <div class="tab-content" id="paymentTabsContent">
                            <!-- Tab 1: Bank QR Transfer -->
                            <div class="tab-pane fade show active" id="qr-pane" role="tabpanel" aria-labelledby="qr-tab">
                                <div class="row align-items-center">
                                    <div class="col-md-5 text-center">
                                        <!-- Beautiful Custom Mock QR Code SVG -->
                                        <svg class="mx-auto d-block mb-3 border p-2 bg-white rounded-3 shadow-sm" width="160" height="160" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                                            <rect x="5" y="5" width="25" height="25" fill="#1b1b1b"/>
                                            <rect x="9" y="9" width="17" height="17" fill="#fff"/>
                                            <rect x="13" y="13" width="9" height="9" fill="#1b1b1b"/>
                                            <rect x="70" y="5" width="25" height="25" fill="#1b1b1b"/>
                                            <rect x="74" y="9" width="17" height="17" fill="#fff"/>
                                            <rect x="78" y="13" width="9" height="9" fill="#1b1b1b"/>
                                            <rect x="5" y="70" width="25" height="25" fill="#1b1b1b"/>
                                            <rect x="9" y="74" width="17" height="17" fill="#fff"/>
                                            <rect x="13" y="78" width="9" height="9" fill="#1b1b1b"/>
                                            <rect x="35" y="5" width="5" height="10" fill="#1b1b1b"/>
                                            <rect x="45" y="5" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="60" y="5" width="5" height="5" fill="#1b1b1b"/>
                                            <rect x="35" y="20" width="15" height="5" fill="#1b1b1b"/>
                                            <rect x="55" y="15" width="10" height="10" fill="#1b1b1b"/>
                                            <rect x="5" y="35" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="20" y="35" width="5" height="15" fill="#1b1b1b"/>
                                            <rect x="5" y="45" width="5" height="10" fill="#1b1b1b"/>
                                            <rect x="15" y="50" width="15" height="5" fill="#1b1b1b"/>
                                            <rect x="35" y="35" width="30" height="30" fill="#0d6efd"/>
                                            <rect x="40" y="40" width="20" height="20" fill="#fff"/>
                                            <text x="50" y="53" font-family="sans-serif" font-weight="bold" font-size="8" fill="#0d6efd" text-anchor="middle">BANK</text>
                                            <rect x="70" y="35" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="85" y="35" width="10" height="10" fill="#1b1b1b"/>
                                            <rect x="75" y="45" width="5" height="15" fill="#1b1b1b"/>
                                            <rect x="85" y="50" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="35" y="70" width="5" height="15" fill="#1b1b1b"/>
                                            <rect x="45" y="70" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="45" y="80" width="15" height="5" fill="#1b1b1b"/>
                                            <rect x="35" y="90" width="20" height="5" fill="#1b1b1b"/>
                                            <rect x="70" y="70" width="5" height="5" fill="#1b1b1b"/>
                                            <rect x="80" y="70" width="15" height="10" fill="#1b1b1b"/>
                                            <rect x="70" y="80" width="10" height="5" fill="#1b1b1b"/>
                                            <rect x="75" y="90" width="20" height="5" fill="#1b1b1b"/>
                                        </svg>
                                        <p class="text-muted small mb-0"><span class="badge bg-info text-dark">MÃ QR GIẢ LẬP</span></p>
                                    </div>
                                    <div class="col-md-7 mt-3 mt-md-0">
                                        <h5 class="fw-semibold text-primary mb-3">Thông tin chuyển khoản</h5>
                                        <div class="mb-2">
                                            <span class="text-muted d-block small">Ngân hàng thụ hưởng</span>
                                            <strong class="text-dark">Ngân hàng TMCP Việt Nam (DemoBank)</strong>
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-muted d-block small">Số tài khoản</span>
                                            <strong class="text-dark fs-5">9999 8888 6666</strong>
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-muted d-block small">Chủ tài khoản</span>
                                            <strong class="text-dark">CONG TY SUU TRUYEN DEMO</strong>
                                        </div>
                                        <div class="mb-2">
                                            <span class="text-muted d-block small">Nội dung chuyển khoản</span>
                                            <strong class="text-danger fs-6">SUUTRUYEN VIP @(currentUserName ?? "USER") @Model.id_Membership</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 2: Momo E-Wallet -->
                            <div class="tab-pane fade" id="momo-pane" role="tabpanel" aria-labelledby="momo-tab">
                                <div class="row align-items-center">
                                    <div class="col-md-5 text-center">
                                        <!-- Momo custom SVG -->
                                        <svg class="mx-auto d-block mb-3 border p-2 bg-white rounded-3 shadow-sm" width="160" height="160" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                                            <rect x="5" y="5" width="25" height="25" fill="#a50064"/>
                                            <rect x="9" y="9" width="17" height="17" fill="#fff"/>
                                            <rect x="13" y="13" width="9" height="9" fill="#a50064"/>
                                            <rect x="70" y="5" width="25" height="25" fill="#a50064"/>
                                            <rect x="74" y="9" width="17" height="17" fill="#fff"/>
                                            <rect x="78" y="13" width="9" height="9" fill="#a50064"/>
                                            <rect x="5" y="70" width="25" height="25" fill="#a50064"/>
                                            <rect x="9" y="74" width="17" height="17" fill="#fff"/>
                                            <rect x="13" y="78" width="9" height="9" fill="#a50064"/>
                                            <rect x="35" y="5" width="5" height="10" fill="#a50064"/>
                                            <rect x="45" y="5" width="10" height="5" fill="#a50064"/>
                                            <rect x="60" y="5" width="5" height="5" fill="#a50064"/>
                                            <rect x="35" y="35" width="30" height="30" fill="#a50064"/>
                                            <rect x="40" y="40" width="20" height="20" fill="#fff"/>
                                            <text x="50" y="53" font-family="sans-serif" font-weight="bold" font-size="7" fill="#a50064" text-anchor="middle">MoMo</text>
                                            <rect x="70" y="35" width="10" height="5" fill="#a50064"/>
                                            <rect x="85" y="35" width="10" height="10" fill="#a50064"/>
                                            <rect x="35" y="70" width="5" height="15" fill="#a50064"/>
                                            <rect x="45" y="80" width="15" height="5" fill="#a50064"/>
                                            <rect x="70" y="70" width="5" height="5" fill="#a50064"/>
                                            <rect x="80" y="70" width="15" height="10" fill="#a50064"/>
                                            <rect x="75" y="90" width="20" height="5" fill="#a50064"/>
                                        </svg>
                                        <p class="text-muted small mb-0"><span class="badge bg-pink text-white" style="background-color: #a50064;">VÍ MOMO GIẢ LẬP</span></p>
                                    </div>
                                    <div class="col-md-7 mt-3 mt-md-0">
                                        <h5 class="fw-semibold text-primary mb-3">Thanh toán qua ví MoMo</h5>
                                        <ol class="small text-muted ps-3">
                                            <li class="mb-2">Mở ứng dụng <strong>Ví MoMo</strong> trên điện thoại.</li>
                                            <li class="mb-2">Chọn tính năng <strong>Quét mã</strong> và quét mã QR code ở bên.</li>
                                            <li class="mb-2">Xác nhận số tiền chuyển là <strong class="text-dark">@Model.Price.ToString("N0") VNĐ</strong>.</li>
                                            <li class="mb-0">Nhấn nút <strong>Thanh toán thành công</strong> ở cột bên phải sau khi quét mã.</li>
                                        </ol>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: International Credit Card -->
                            <div class="tab-pane fade" id="card-pane" role="tabpanel" aria-labelledby="card-tab">
                                <h5 class="fw-semibold text-primary mb-3">Nhập thông tin thẻ quốc tế (Giả lập)</h5>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label small text-muted">Số thẻ</label>
                                        <input type="text" class="form-control rounded-3" placeholder="4111 2222 3333 4444" value="4111 2222 3333 4444" disabled>
                                        <span class="form-text text-muted small">Thông tin thẻ đã được điền sẵn để tiện demo.</span>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Hạn sử dụng</label>
                                        <input type="text" class="form-control rounded-3" placeholder="12/29" value="12/29" disabled>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted">Mã CVV</label>
                                        <input type="password" class="form-control rounded-3" placeholder="***" value="123" disabled>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small text-muted">Tên trên thẻ</label>
                                        <input type="text" class="form-control rounded-3 text-uppercase" placeholder="NGUYEN VAN A" value="NGUYEN VAN A" disabled>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Summary & Actions -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4">
                        <h4 class="fw-bold mb-0 text-dark">Đơn hàng của bạn</h4>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold mb-0 text-primary">@Model.Name</h5>
                                <small class="text-muted">Thời hạn sử dụng: @Model.Duration ngày</small>
                            </div>
                            <span class="badge bg-primary rounded-pill px-3 py-2">Gói VIP</span>
                        </div>

                        <hr class="my-3 text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Tạm tính</span>
                            <span class="fw-semibold text-dark">@Model.Price.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Khuyến mãi</span>
                            <span class="fw-semibold text-success">0 VNĐ</span>
                        </div>
                        
                        <hr class="my-3 text-muted opacity-25">

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold text-dark fs-5">Tổng tiền thanh toán</span>
                            <span class="fw-bold text-danger fs-4">@Model.Price.ToString("N0") VNĐ</span>
                        </div>

                        <!-- Success action form -->
                        <form id="successForm" asp-controller="Membership" asp-action="ProcessPayment" method="post">
                            <input type="hidden" name="id" value="@Model.id_Membership" />
                            <input type="hidden" id="successPaymentMethod" name="paymentMethod" value="Chuyển khoản QR" />
                            <input type="hidden" name="status" value="success" />
                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold py-3 mb-2 shadow-sm">
                                Xác nhận thanh toán thành công
                            </button>
                        </form>

                        <!-- Failure test action form -->
                        <form id="failedForm" asp-controller="Membership" asp-action="ProcessPayment" method="post">
                            <input type="hidden" name="id" value="@Model.id_Membership" />
                            <input type="hidden" id="failedPaymentMethod" name="paymentMethod" value="Chuyển khoản QR" />
                            <input type="hidden" name="status" value="failed" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill py-2">
                                Giả lập giao dịch thất bại (Để test)
                            </button>
                        </form>

                        <a asp-controller="Membership" asp-action="Index" class="btn btn-link text-muted w-100 text-center mt-3 text-decoration-none small">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-1" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                            </svg> Quay lại gói hội viên
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Khi người dùng chuyển đổi tab phương thức thanh toán
            $('button[data-bs-toggle="tab"]').on('shown.bs.tab', function (e) {
                var targetTabId = $(e.target).attr('id');
                var methodText = "Chuyển khoản QR";
                
                if (targetTabId === "momo-tab") {
                    methodText = "Ví Momo";
                } else if (targetTabId === "card-tab") {
                    methodText = "Thẻ tín dụng";
                }
                
                // Cập nhật giá trị phương thức thanh toán vào form
                $('#successPaymentMethod').val(methodText);
                $('#failedPaymentMethod').val(methodText);
            });
        });
    </script>
}
