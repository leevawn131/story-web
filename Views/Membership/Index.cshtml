@model IEnumerable<story_web.Models.Membership>

@{
    ViewData["Title"] = "Gói Hội Viên";
}

<main class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">Nâng Cấp Gói Hội Viên</h1>
            <p class="lead text-muted">Trở thành hội viên để mở khóa các tính năng đặc quyền như Nghe Audio và nhiều hơn thế nữa!</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4 justify-content-center">
            @if (Model != null && Model.Any())
            {
                foreach (var plan in Model)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card h-100 shadow-sm border-0 rounded-4 text-center">
                            <div class="card-header bg-transparent border-0 pt-4">
                                <h3 class="fw-bold text-primary">@plan.Name</h3>
                            </div>
                            <div class="card-body">
                                <div class="display-6 fw-bold mb-3">
                                    @plan.Price.ToString("N0") <span class="fs-5 text-muted fw-normal">VNĐ</span>
                                </div>
                                <p class="text-muted mb-4">Thời hạn: <strong>@plan.Duration ngày</strong></p>
                                
                                <div class="text-start mb-4">
                                    <div class="fw-semibold mb-2">Đặc quyền:</div>
                                    <ul class="list-unstyled">
                                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                                        {
                                            @foreach (var desc in plan.Description.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <li class="mb-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-check-circle-fill text-success me-2" viewBox="0 0 16 16">
                                                      <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                                                    </svg>
                                                    @desc.Trim()
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </div>
                            <div class="card-footer bg-transparent border-0 pb-4">
                                <a asp-controller="Membership" asp-action="Checkout" asp-route-id="@plan.id_Membership" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold">Mua Ngay</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p class="text-muted">Hiện tại chưa có gói hội viên nào.</p>
                </div>
            }
        </div>
    </div>
</main>
