@model HomeIndexViewModel

<main class="py-5">

    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h1 class="h2 mb-1">@Model.Title</h1>
                <p class="text-muted mb-0">Duyệt truyện, tiếp tục đọc hoặc lưu yêu thích của bạn.</p>
            </div>
            @if (Context.Session.IsAuthenticated())
            {
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Library" asp-action="History" class="btn btn-outline-primary">Thư viện của tôi</a>
                    <a asp-controller="Writer" asp-action="Stories" class="btn btn-primary">Truyện của tôi</a>
                </div>
            }
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body">
                <form asp-controller="Home" asp-action="Index" method="get" class="row g-3">
                    <div class="col-12 col-lg-8">
                        <label for="searchTerm" class="form-label">Tìm kiếm truyện hoặc tác giả</label>
                        <input id="searchTerm" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Tìm kiếm theo tên truyện hoặc bút danh" />
                    </div>
                    <div class="col-12 col-lg-4 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="row mb-4">

            <!-- Top Views -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">🔥 Top lượt xem</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.TopViews)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.StoryName</span>
                                <span class="text-muted">@item.Views lượt xem</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- Top Favourites -->
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-header fw-bold">❤️ Top yêu thích</div>
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.TopFavourites)
                        {
                            <li class="list-group-item d-flex justify-content-between">
                                <span>@item.StoryName</span>
                                <span class="text-muted">@item.FavouriteCount yêu thích</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

        </div>
        @if (Model.Categories.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn @(Model.CategoryId.HasValue ? "btn-outline-secondary" : "btn-dark") btn-sm">Tất cả</a>
                @foreach (var category in Model.Categories)
                {
                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-id="@category.CategoryId"
                       class="btn @(category.IsActive ? "btn-dark" : "btn-outline-secondary") btn-sm">
                        @category.CategoryName
                    </a>
                }
            </div>
        }

        <partial name="_StoryCards" model="Model.Stories" />
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h3 border-left border-primary border-4 pl-3" style="color: #fff;">Mới cập nhật</h2>
        <a asp-action="Index" class="btn btn-sm btn-primary">Xem tất cả</a>
    </div>

    <div class="row">
        @foreach (var story in Model.LatestUpdatedStories)
        {
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 mb-4"> 
                <div class="card story-card shadow-sm h-100" style="background: #212529; border: 1px solid #444;">
                    <a asp-action="Story" asp-route-id="@story.StoryId" class="text-decoration-none">
                        
                        <div class="story-img-container" style="position: relative; width: 100%; height: 230px; overflow: hidden; background: #000;">
                            @if (!string.IsNullOrWhiteSpace(story.ImageUrl))
                            {
                                <img src="@story.ImageUrl" alt="@story.StoryName" 
                                     style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted small">Không ảnh</div>
                            }
                            
                            <span class="badge badge-dark" style="position: absolute; bottom: 5px; left: 5px; font-size: 10px; background: rgba(0,0,0,0.7);">
                                @story.ChapterCount chương
                            </span>
                            <span class="badge badge-warning" style="position: absolute; top: 5px; right: 5px; font-size: 10px;">
                                <i class="fas fa-eye"></i> @story.Views
                            </span>
                        </div>

                        <div class="card-body p-2">
                            <h5 class="story-title" style="color: #fff; font-size: 14px; font-weight: bold; margin-bottom: 5px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 38px; line-height: 1.4;">
                                @story.StoryName
                            </h5>
                            <p class="small text-muted mb-0" style="font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <i class="fas fa-user"></i> @story.AuthorName
                            </p>
                        </div>
                    </a>
                </div>
            </div>
        }
    </div>
</section>
    </div>
</main>
