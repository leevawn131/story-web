@model HomeIndexViewModel

<main class="py-5">
    <div class="container">
        <div class="mb-4">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none small">Back to all stories</a>
            <h1 class="h2 mt-2 mb-1">@Model.Title</h1>
            <p class="text-muted mb-0">Filter stories by category and continue reading from where you stopped.</p>
        </div>

        @if (Model.Categories.Count > 0)
        {
            <div class="d-flex flex-wrap gap-2 mb-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">All</a>
                @foreach (var category in Model.Categories)
                {
                    <a asp-controller="Home"
                       asp-action="Category"
                       asp-route-id="@category.CategoryId"
                       class="btn @(category.IsActive ? "btn-dark" : "btn-outline-secondary") btn-sm">
                        @category.CategoryName
                    </a>
                }
            </div>
        }

        <partial name="_StoryCards" model="Model.Stories" />
    </div>
</main>
