@model StoryDetailsViewModel
@{
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string FormatChapterNumber(decimal? number)
    {
        if (!number.HasValue)
        {
            return "?";
        }

        return decimal.Truncate(number.Value) == number.Value
            ? decimal.ToInt32(number.Value).ToString()
            : number.Value.ToString("0.##");
    }
}

<main class="py-5">
    <div class="container">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.StoryName" style="height: 420px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 420px;">
                            No cover image
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span class="badge text-bg-light">@Model.CategoryName</span>
                            }
                            <span class="badge text-bg-warning">@Model.FavouriteCount favorites</span>
                        </div>

                        <h1 class="h2 mb-2">@Model.StoryName</h1>
                        <p class="text-muted mb-3">By @(string.IsNullOrWhiteSpace(Model.AuthorName) ? "Unknown author" : Model.AuthorName)</p>

                        <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
                            <div class="col">
                                <div class="border rounded p-3 h-100">
                                    <div class="small text-muted">Chapters</div>
                                    <div class="fw-semibold">@Model.Chapters.Count</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="border rounded p-3 h-100">
                                    <div class="small text-muted">Views</div>
                                    <div class="fw-semibold">@Model.Views</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="border rounded p-3 h-100">
                                    <div class="small text-muted">Posted</div>
                                    <div class="fw-semibold">@(Model.PostedAt?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                                </div>
                            </div>
                            <div class="col">
                                <div class="border rounded p-3 h-100">
                                    <div class="small text-muted">Updated</div>
                                    <div class="fw-semibold">@(Model.ModifiedAt?.ToString("dd/MM/yyyy") ?? "N/A")</div>
                                </div>
                            </div>
                        </div>

                        <p class="mb-4">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description available for this story yet." : Model.Description)</p>

                        <div class="d-flex flex-wrap gap-2">
                            @if (Model.ContinueReadingChapterId.HasValue)
                            {
                                <a asp-controller="Home" asp-action="Chapter" asp-route-id="@Model.ContinueReadingChapterId" class="btn btn-primary">Continue reading</a>
                            }
                            else if (Model.Chapters.Count > 0)
                            {
                                <a asp-controller="Home" asp-action="Chapter" asp-route-id="@Model.Chapters[0].ChapterId" class="btn btn-primary">Start reading</a>
                            }

                            @if (Context.Session.IsAuthenticated())
                            {
                                <form asp-controller="Home" asp-action="ToggleFavourite" method="post" class="d-inline">
                                    <input type="hidden" name="storyId" value="@Model.StoryId" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="btn @(Model.IsFavourite ? "btn-warning" : "btn-outline-warning")">
                                        @(Model.IsFavourite ? "Remove favorite" : "Add to favorites")
                                    </button>
                                </form>
                            }

                            @if (Model.CanManage)
                            {
                                <a asp-controller="Writer" asp-action="Chapters" asp-route-storyId="@Model.StoryId" class="btn btn-outline-secondary">Manage story</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">Chapter list</h2>
                    <span class="text-muted">@Model.Chapters.Count chapter(s)</span>
                </div>

                @if (Model.Chapters.Count == 0)
                {
                    <div class="alert alert-light border mb-0">This story does not have any chapters yet.</div>
                }
                else
                {
                    <div class="list-group">
                        @foreach (var chapter in Model.Chapters)
                        {
                            <a asp-controller="Home" asp-action="Chapter" asp-route-id="@chapter.ChapterId" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">Chapter @FormatChapterNumber(chapter.ChapterNumber): @chapter.ChapterName</div>
                                    <small class="text-muted">@(chapter.PostedAt?.ToString("dd/MM/yyyy HH:mm") ?? "No timestamp")</small>
                                </div>
                                <span class="btn btn-sm btn-outline-primary">Read</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>
