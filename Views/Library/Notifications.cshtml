@model NotificationsPageViewModel

<main class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <a asp-controller="Account" asp-action="Profile" class="text-decoration-none small">Quay lại hồ sơ</a>
                <h1 class="h2 mt-2 mb-1">Thông báo</h1>
                <p class="text-muted mb-0">Cập nhật gần đây từ tài khoản và hoạt động viết của bạn.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Library" asp-action="History" class="btn btn-outline-primary">Lịch sử</a>
                <a asp-controller="Library" asp-action="Favorites" class="btn btn-outline-primary">Yêu thích</a>
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border">Chưa có thông báo nào.</div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var item in Model.Items)
                {
                    <div class="list-group-item">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div>
                                <div class="fw-semibold">@item.Content</div>
                                <div class="text-muted small">@(item.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (!item.IsRead)
                                {
                                    <span class="badge text-bg-primary">Mới</span>
                                    <form asp-action="MarkNotificationRead" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.NotificationId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm">Đánh dấu đã đọc</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge text-bg-light">Đã đọc</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>
