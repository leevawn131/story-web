@model LibraryPageViewModel

<main class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <a asp-controller="Account" asp-action="Profile" class="text-decoration-none small">Back to profile</a>
                <h1 class="h2 mt-2 mb-1">@Model.Title</h1>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Library" asp-action="History" class="btn btn-outline-primary">History</a>
                <a asp-controller="Library" asp-action="Favorites" class="btn btn-outline-primary">Favorites</a>
                <a asp-controller="Library" asp-action="Notifications" class="btn btn-outline-primary">Notifications</a>
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="alert alert-light border">@Model.EmptyMessage</div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var item in Model.Items)
                {
                    <div class="list-group-item">
                        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                            <div>
                                <div class="fw-semibold">@item.StoryName</div>
                                <div class="text-muted small">@(item.Subtitle ?? string.Empty)</div>
                                <div class="text-muted small">@(item.ActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</div>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Home" asp-action="Story" asp-route-id="@item.StoryId" class="btn btn-outline-secondary btn-sm">Story</a>
                                @if (item.ChapterId.HasValue)
                                {
                                    <a asp-controller="Home" asp-action="Chapter" asp-route-id="@item.ChapterId" class="btn btn-primary btn-sm">Open chapter</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</main>
