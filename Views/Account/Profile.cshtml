@model ProfileViewModel

<main class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
            <div>
                <h1 class="h2 mb-1">My Profile</h1>
                <p class="text-muted mb-0">Manage your account, library, and writing space.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Library" asp-action="History" class="btn btn-outline-primary">My Library</a>
                <a asp-controller="Writer" asp-action="Stories" class="btn btn-primary">Writer Studio</a>
                @if (Context.Session.GetCurrentUserRole() == UserRoles.Admin)
                {
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-outline-dark">Admin</a>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success">@successMessage</div>
        }

        <div class="row g-4 mb-4">
            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Account overview</h2>
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Username</dt>
                            <dd class="col-sm-7">@Model.UserName</dd>

                            <dt class="col-sm-5">Email</dt>
                            <dd class="col-sm-7">@Model.Email</dd>

                            <dt class="col-sm-5">Pen name</dt>
                            <dd class="col-sm-7">@(Model.PenName ?? "Not set")</dd>

                            <dt class="col-sm-5">Created</dt>
                            <dd class="col-sm-7">@(Model.CreatedDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Update profile</h2>
                        <form asp-action="UpdateProfile" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="UpdateProfile.UserName" class="form-label"></label>
                                <input asp-for="UpdateProfile.UserName" class="form-control" />
                                <span asp-validation-for="UpdateProfile.UserName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UpdateProfile.Email" class="form-label"></label>
                                <input asp-for="UpdateProfile.Email" class="form-control" />
                                <span asp-validation-for="UpdateProfile.Email" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UpdateProfile.PenName" class="form-label"></label>
                                <input asp-for="UpdateProfile.PenName" class="form-control" />
                                <span asp-validation-for="UpdateProfile.PenName" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Change password</h2>
                        <form asp-action="ChangePassword" method="post">
                            <div class="mb-3">
                                <label asp-for="ChangePassword.OldPassword" class="form-label"></label>
                                <input asp-for="ChangePassword.OldPassword" class="form-control" />
                                <span asp-validation-for="ChangePassword.OldPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ChangePassword.NewPassword" class="form-label"></label>
                                <input asp-for="ChangePassword.NewPassword" class="form-control" />
                                <span asp-validation-for="ChangePassword.NewPassword" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ChangePassword.ConfirmNewPassword" class="form-label"></label>
                                <input asp-for="ChangePassword.ConfirmNewPassword" class="form-control" />
                                <span asp-validation-for="ChangePassword.ConfirmNewPassword" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-dark">Update password</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 mb-0">Reading history</h2>
                            <a asp-controller="Library" asp-action="History" class="small text-decoration-none">View all</a>
                        </div>

                        @if (Model.ReadingHistory.Count == 0)
                        {
                            <p class="text-muted mb-0">No reading history yet.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in Model.ReadingHistory)
                                {
                                    <a asp-controller="Home"
                                       asp-action="@(item.ChapterId.HasValue ? "Chapter" : "Story")"
                                       asp-route-id="@(item.ChapterId ?? item.StoryId)"
                                       class="list-group-item list-group-item-action px-0">
                                        <div class="fw-semibold">@item.StoryName</div>
                                        <small class="text-muted d-block">@(item.Subtitle ?? "Recently read")</small>
                                        <small class="text-muted">@(item.ActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</small>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 mb-0">Favorite stories</h2>
                            <a asp-controller="Library" asp-action="Favorites" class="small text-decoration-none">View all</a>
                        </div>

                        @if (Model.FavouriteStories.Count == 0)
                        {
                            <p class="text-muted mb-0">You have not added any favorites yet.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in Model.FavouriteStories)
                                {
                                    <a asp-controller="Home" asp-action="Story" asp-route-id="@item.StoryId" class="list-group-item list-group-item-action px-0">
                                        <div class="fw-semibold">@item.StoryName</div>
                                        <small class="text-muted d-block">@(item.Subtitle ?? "Favorite")</small>
                                        <small class="text-muted">@(item.ActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</small>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 mb-0">My stories</h2>
                            <a asp-controller="Writer" asp-action="Stories" class="small text-decoration-none">Manage</a>
                        </div>

                        @if (Model.PostedStories.Count == 0)
                        {
                            <p class="text-muted mb-0">You have not posted any stories yet.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var item in Model.PostedStories)
                                {
                                    <a asp-controller="Writer" asp-action="Chapters" asp-route-storyId="@item.StoryId" class="list-group-item list-group-item-action px-0">
                                        <div class="fw-semibold">@item.StoryName</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                        {
                                            <small class="text-muted d-block">@item.Subtitle</small>
                                        }
                                        <small class="text-muted">@(item.ActivityAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</small>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mt-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Recent notifications</h2>
                    <a asp-controller="Library" asp-action="Notifications" class="small text-decoration-none">View all</a>
                </div>

                @if (Model.Notifications.Count == 0)
                {
                    <p class="text-muted mb-0">No notifications yet.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.Notifications)
                        {
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div>
                                        <div class="fw-semibold">@item.Content</div>
                                        <small class="text-muted">@(item.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? string.Empty)</small>
                                    </div>
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge text-bg-primary">New</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
