@model ForgotPasswordViewModel

<main class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <h1 class="h3 mb-2">Forgot Password</h1>
                        <p class="text-muted mb-4">Enter your email and we will simulate a reset request.</p>

                        @if (ViewBag.ResetMessage is string resetMessage)
                        {
                            <div class="alert alert-info" role="alert">@resetMessage</div>
                        }

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <form asp-action="ForgotPassword" method="post">
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Send reset request</button>
                        </form>

                        <div class="text-center mt-4">
                            <a asp-action="Login" class="text-decoration-none">Back to login</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
