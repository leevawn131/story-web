@model LoginViewModel

<main class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-lg-5">
                        <h1 class="h3 mb-2">Đăng nhập</h1>
                        <p class="text-muted mb-4">Đăng nhập với tên đăng nhập và mật khẩu của bạn.</p>

                        @if (TempData["SuccessMessage"] is string successMessage)
                        {
                            <div class="alert alert-success" role="alert">@successMessage</div>
                        }

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <form asp-action="Login" method="post">
                            <input asp-for="ReturnUrl" type="hidden" />

                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label"></label>
                                <input asp-for="UserName" class="form-control" autocomplete="username" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label"></label>
                                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
                        </form>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <a asp-action="Register" class="text-decoration-none">Tạo tài khoản</a>
                            <a asp-action="ForgotPassword" class="text-decoration-none">Quên mật khẩu?</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
