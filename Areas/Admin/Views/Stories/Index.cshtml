@using story_web.Models
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}
@model List<Story>

<h2>Quản lý truyện</h2>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<div class="d-flex flex-wrap gap-2 mb-3">
    <a asp-action="Index"
       class="btn btn-sm @(string.IsNullOrEmpty(ViewData["CurrentStatus"] as string) ? "btn-primary" : "btn-outline-primary")">
        Tất cả
    </a>
    <a asp-action="Index"
       asp-route-status="cho_duyet"
       class="btn btn-sm @((ViewData["CurrentStatus"] as string) == "cho_duyet" ? "btn-warning" : "btn-outline-warning")">
        Chờ duyệt
    </a>
    <a asp-action="Index"
       asp-route-status="da_duyet"
       class="btn btn-sm @((ViewData["CurrentStatus"] as string) == "da_duyet" ? "btn-success" : "btn-outline-success")">
        Đang hiển thị
    </a>
    <a asp-action="Index"
       asp-route-status="tu_choi"
       class="btn btn-sm @((ViewData["CurrentStatus"] as string) == "tu_choi" ? "btn-danger" : "btn-outline-danger")">
        Từ chối
    </a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Tên truyện</th>
            <th>Tác giả</th>
            <th>Mô tả</th>
            <th>Trạng thái</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.StoryName</td>
                <td>@s.Author?.PenName</td>
                <td>@(s.Description?.Substring(0, Math.Min(50, s.Description.Length)) ?? "N/A")...</td>
                <td>
                    @if (s.PostStatus == "cho_duyet")
                    {
                        <span class="badge bg-warning">Chờ duyệt</span>
                    }
                    else if (s.PostStatus == "da_duyet")
                    {
                        <span class="badge bg-success">Đang hiển thị</span>
                    }
                    else if (s.PostStatus == "tu_choi")
                    {
                        <span class="badge bg-danger">Từ chối</span>
                    }
                </td>
                <td>
                    @if (s.PostStatus == "cho_duyet")
                    {
                        <form method="post" asp-action="Approve" asp-route-id="@s.id_Story" style="display:inline;">
                            <button type="submit" class="btn btn-success btn-sm">✔️ Duyệt</button>
                        </form>
                        <button class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal@s.id_Story">❌ Từ chối</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@* Reject modals for each story *@
@foreach (var s in Model)
{
    @if (s.PostStatus == "cho_duyet")
    {
        <div class="modal fade" id="rejectModal@s.id_Story" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Từ chối: @s.StoryName</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <form method="post" asp-action="Reject" asp-route-id="@s.id_Story">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="reason@s.id_Story" class="form-label">Lý do từ chối (tùy chọn)</label>
                                <textarea class="form-control" id="reason@s.id_Story" name="reason" rows="4" placeholder="Nhập lý do từ chối..."></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-danger">Xác nhận từ chối</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}