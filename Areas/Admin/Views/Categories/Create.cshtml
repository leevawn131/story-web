@model story_web.Models.Category

<h2>Thêm thể loại</h2>

<form method="post">
    <div class="form-group">
        <label>Tên</label>
        <input asp-for="CategoryName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Mô tả</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <button class="btn btn-success mt-2">Lưu</button>
</form>