@model List<story_web.Models.Payment>

@{
    ViewData["Title"] = "Quản lý thanh toán";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h1 class="h3 mb-4 text-gray-800">Quản lý thanh toán</h1>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            Danh sách giao dịch
        </h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered" width="100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Gói hội viên</th>
                        <th>Số tiền</th>
                        <th>Phương thức</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th width="120">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.id_Payment</td>
                            <td>@p.User?.UserName</td>
                            <td>@p.Membership?.Name</td>
                            <td>@p.Amount.ToString("N0") VNĐ</td>
                            <td>@p.PaymentMethod</td>
                            <td>
                                @if (p.Status == "success")
                                {
                                    <span class="badge badge-success">
                                        Thành công
                                    </span>
                                }
                                else if (p.Status == "pending")
                                {
                                    <span class="badge badge-warning">
                                        Đang chờ
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">
                                        Thất bại
                                    </span>
                                }
                            </td>
                            <td>
                                @p.Created_At.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <a asp-area="Admin"
                                   asp-controller="Payments"
                                   asp-action="Details"
                                   asp-route-id="@p.id_Payment"
                                   class="btn btn-info btn-sm">
                                    Chi tiết
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="Payments"
                                   asp-action="Delete"
                                   asp-route-id="@p.id_Payment"
                                   class="btn btn-danger btn-sm mt-1">
                                    Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>